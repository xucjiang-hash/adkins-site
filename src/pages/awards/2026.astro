---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
  </head>

  <body>
    <main class="page">
      <div class="top-actions">
        <a class="back-home" href="/">← 返回主页</a>
      </div>

      <header class="hero">
        <div class="hero-img">
          <img src={heroImg} alt={pageTitle} />
        </div>

        <div class="hero-text">
          <div class="kicker">Brian-Adkins Awards</div>
          <h1 class="title">{pageTitle}</h1>
          <p class="subtitle">{subtitle}</p>
        </div>
      </header>

      {/* 竖排布局：获奖名单 -> 入围名单 */}
      <section class="stack">
        {/* 获奖名单 */}
        <div class="panel">
          <div class="panel-head">
            <h2 class="panel-title">获奖名单</h2>
          </div>

          <div class="award-grid">
            {awards.map((block) => (
              <section class="card">
                <h3 class="card-title">{block.section}</h3>
                <div class="kv">
                  {block.items.map((it) => (
                    <div class="kv-row">
                      <div class="kv-k">{it.label}</div>
                      <div class="kv-v" title={it.value} set:html={it.value} />
                    </div>
                  ))}
                </div>
              </section>
            ))}
          </div>

          <section class="card wide">
            <h3 class="card-title">{specialFocus.title}</h3>
            <div class="kv">
              {specialFocus.rows.map((r) => (
  <div class="kv-row">
    <div class="kv-k">{r.label}</div>
    <div class="kv-v" title={r.value} set:html={r.value} />
  </div>
))}
            </div>
          </section>
        </div>

        {/* 入围名单 */}
        <div class="panel">
          <div class="panel-head">
            <h2 class="panel-title">主竞赛名单</h2>
          </div>

          <section class="card wide">
            <h3 class="card-title">{shortlistIntro.title}</h3>
            <div class="muted">{shortlistIntro.range}</div>

            <ol class="pick-list">
              {shortlist.map((p, idx) => (
                <li class="pick-item">
                  <span class="pick-no">{idx + 1}.</span>
                  <span class="pick-main" title={`【${p.country}】${p.director}${p.title}`}>
                    <span class="pick-country">【{p.country}】</span>
                    <span class="pick-text">{p.director}{p.title}</span>
                  </span>
                </li>
              ))}
            </ol>
          </section>
        </div>
      </section>

      <footer class="footnote">
        <span class="line">所谓生活，无非时间、空间和你。</span>
      </footer>
    </main>

    <style>
      body{ margin:0; font-family: system-ui,"PingFang SC","Microsoft YaHei",sans-serif; background:#fff; color:#111; }
      .page{ max-width:980px; margin:0 auto; padding:40px 20px 70px; }

      .top-actions{ display:flex; justify-content:space-between; margin-bottom:16px; }
      .back-home{ text-decoration:none; font-size:14px; padding:6px 10px; border-radius:10px; color:#777; }
      .back-home:hover{ background:#f0f0f0; color:#111; }

      .hero-img img{ width:100%; border-radius:16px; border:1px solid #e5e5e5; display:block; }
      .hero-text{ margin-top:20px; }
      .kicker{ font-size:13px; letter-spacing:.14em; opacity:.6; }
      .title{ font-size:clamp(34px,5vw,54px); margin:8px 0 0; }
      .subtitle{ color:#777; margin-top:10px; }

      .stack{ margin-top:26px; display:grid; grid-template-columns: 1fr; gap:14px; }

      .panel{ background:#f6f6f6; border-radius:18px; padding:16px; }
      .panel-head{ display:flex; align-items:baseline; justify-content:space-between; margin-bottom:10px; }
      .panel-title{ margin:0; font-size:18px; letter-spacing:.02em; }

      .award-grid{
        display:grid;
        grid-template-columns: 1fr 1fr;
        gap:12px;
      }
      @media (max-width: 860px){
        .award-grid{ grid-template-columns:1fr; }
      }

      .card{
        background:#fff;
        border:1px solid #e8e8e8;
        border-radius:14px;
        padding:14px;
      }
      .card.wide{ margin-top:12px; }

      .card-title{
        margin:0 0 10px;
        font-size:18px;
        font-weight:750;
        letter-spacing:.01em;
      }

      .kv{ display:grid; gap:8px; }
      .kv-row{
        display:grid;
        grid-template-columns: 130px 1fr;
        gap:12px;
        align-items:baseline;
      }
      .kv-k{ color:#666; font-size:13px; white-space:nowrap; }
      .kv-v{
        color:#111;
        font-size:13px;
        white-space:nowrap;
        overflow:hidden;
        text-overflow:ellipsis;
      }

      .muted{ color:#777; font-size:13px; margin-top:2px; }

      .pick-list{
        margin:12px 0 0;
        padding:0;
        list-style:none;
        display:grid;
        gap:10px;
      }
      .pick-item{
        display:grid;
        grid-template-columns: 34px 1fr;
        gap:8px;
        align-items:baseline;
      }
      .pick-no{ font-weight:700; color:#111; }
      .pick-main{
        font-size:14px;
        white-space:nowrap;
        overflow:hidden;
        text-overflow:ellipsis;
      }
      .pick-country{ color:#666; margin-right:6px; }
      .pick-text{ color:#111; }

      .footnote{
        margin-top:30px;
        padding-top:18px;
        border-top:1px solid #e5e5e5;
        text-align:center;
        color:#777;
        font-size:14px;
      }
      .footnote .line{ display:block; }
      .footnote .line.muted{ margin-top:6px; color:#999; }
    </style>
  </body>
</html>
